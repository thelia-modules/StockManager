{% set domain = 'stockmanager.bo.default' %}
<div class="mb-3 card" data-testid="stockmanager-rules">
	<div class="card-header">
		<h3 class="mb-0 card-title">{{ 'Stock rules'|trans({}, domain) }}</h3>
	</div>
	<div class="card-body">
		<p class="text-muted">{{ 'When an order changes status, the first rule matching the change decides what happens to the stock. Without a matching rule, Thelia decides as usual: the stock is taken when an unpaid order is paid, and given back when a paid order goes back to unpaid or is cancelled.'|trans({}, domain) }}</p>

		{% if rules is not empty %}
			<div class="table-responsive">
				<table class="table table-striped align-middle" data-testid="stockmanager-rule-list">
					<thead>
						<tr>
							<th>#</th>
							<th>{{ 'From'|trans({}, domain) }}</th>
							<th>{{ 'To'|trans({}, domain) }}</th>
							<th>{{ 'Payment module'|trans({}, domain) }}</th>
							<th>{{ 'Stock'|trans({}, domain) }}</th>
							<th class="text-end">{{ 'Actions'|trans }}</th>
						</tr>
					</thead>
					<tbody>
						{% for rule in rules %}
							<tr data-testid="stockmanager-rule-{{ rule.id }}"{% if rule.broken %} class="table-warning"{% endif %}>
								<td>{{ rule.rank }}</td>
								<td>{{ rule.source ?? ('Deleted status'|trans({}, domain)) }}</td>
								<td>{{ rule.target ?? ('Deleted status'|trans({}, domain)) }}</td>
								<td>{{ rule.payment_module ?? ((rule.broken ? 'Deleted module' : 'Any')|trans({}, domain)) }}</td>
								<td>
									{{ rule.operation ? rule.operation|trans({}, domain) : '' }}
									{% if rule.broken %}
										<div class="small text-danger" data-testid="stockmanager-rule-broken">{{ 'Ignored:'|trans({}, domain) }} {{ rule.broken|trans({}, domain) }}</div>
									{% endif %}
								</td>
								<td class="text-end text-nowrap">
									{% for direction in ['up', 'down'] %}
										{% if (direction == 'up' and not loop.parent.loop.first) or (direction == 'down' and not loop.parent.loop.last) %}
											<form method="post" class="d-inline" action="{{ path('stockmanager.rules.move', {id: rule.id}) }}">
												<input type="hidden" name="_token" value="{{ assignToken() }}">
												<input type="hidden" name="direction" value="{{ direction }}">
												<button type="submit" class="btn btn-outline-secondary btn-sm" title="{{ (direction == 'up' ? 'Move up' : 'Move down')|trans({}, domain) }}">
													<i class="bi bi-arrow-{{ direction }}"></i>
												</button>
											</form>
										{% endif %}
									{% endfor %}
									<form method="post" class="d-inline" action="{{ path('stockmanager.rules.delete', {id: rule.id}) }}">
										<input type="hidden" name="_token" value="{{ assignToken() }}">
										<button type="submit" class="btn btn-danger btn-sm" title="{{ 'Delete'|trans }}">
											<i class="bi bi-trash"></i>
										</button>
									</form>
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		{% else %}
			<div class="alert alert-info" data-testid="stockmanager-no-rule">{{ 'There is no rule: Thelia decides for every status change.'|trans({}, domain) }}</div>
		{% endif %}
	</div>
</div>

<div class="mb-3 card">
	<div class="card-header">
		<h3 class="mb-0 card-title">{{ 'Add a rule'|trans({}, domain) }}</h3>
	</div>
	<div class="card-body">
		<form method="post" action="{{ path('stockmanager.rules.create') }}" class="row g-3" data-testid="stockmanager-rule-form">
			<input type="hidden" name="_token" value="{{ assignToken() }}">
			<div class="col-md-3">
				<label class="form-label" for="stockmanager-source">{{ 'From'|trans({}, domain) }}</label>
				<select class="form-select" id="stockmanager-source" name="source_status_id" required>
					{% for id, title in statuses %}<option value="{{ id }}">{{ title }}</option>{% endfor %}
				</select>
			</div>
			<div class="col-md-3">
				<label class="form-label" for="stockmanager-target">{{ 'To'|trans({}, domain) }}</label>
				<select class="form-select" id="stockmanager-target" name="target_status_id" required>
					{% for id, title in statuses %}<option value="{{ id }}">{{ title }}</option>{% endfor %}
				</select>
			</div>
			<div class="col-md-3">
				<label class="form-label" for="stockmanager-payment">{{ 'Payment module'|trans({}, domain) }}</label>
				<select class="form-select" id="stockmanager-payment" name="payment_module_id">
					<option value="0">{{ 'Any'|trans({}, domain) }}</option>
					{% for id, title in payment_modules %}<option value="{{ id }}">{{ title }}</option>{% endfor %}
				</select>
			</div>
			<div class="col-md-3">
				<label class="form-label" for="stockmanager-operation">{{ 'Stock'|trans({}, domain) }}</label>
				<select class="form-select" id="stockmanager-operation" name="operation" required>
					{% for value, label in operations %}<option value="{{ value }}">{{ label|trans({}, domain) }}</option>{% endfor %}
				</select>
			</div>
			<div class="col-12">
				<button type="submit" class="btn btn-primary">{{ 'Add the rule'|trans({}, domain) }}</button>
			</div>
		</form>
	</div>
</div>

<div class="mb-3 card" data-testid="stockmanager-simulation">
	<div class="card-header">
		<h3 class="mb-0 card-title">{{ 'Simulate a status change'|trans({}, domain) }}</h3>
	</div>
	<div class="card-body">
		<p class="text-muted">{{ 'Give an order to know what its change of status would do to the stock, or a starting status to know which rule would decide. The simulation changes neither the order nor the stock.'|trans({}, domain) }}</p>
		<form method="get" action="{{ path('admin.module.configure', {module_code: 'StockManager'}) }}" class="row g-3">
			<div class="col-md-3">
				<label class="form-label" for="stockmanager-simulate-order">{{ 'Order reference'|trans({}, domain) }}</label>
				<input type="text" class="form-control" id="stockmanager-simulate-order" name="simulate_order" value="{{ simulation.order_reference ?? '' }}">
			</div>
			<div class="col-md-3">
				<label class="form-label" for="stockmanager-simulate-source">{{ 'or from'|trans({}, domain) }}</label>
				<select class="form-select" id="stockmanager-simulate-source" name="simulate_source">
					{% for id, title in statuses %}<option value="{{ id }}"{% if id == simulation_input.source %} selected{% endif %}>{{ title }}</option>{% endfor %}
				</select>
			</div>
			<div class="col-md-3">
				<label class="form-label" for="stockmanager-simulate-payment">{{ 'paid with'|trans({}, domain) }}</label>
				<select class="form-select" id="stockmanager-simulate-payment" name="simulate_payment">
					<option value="0">{{ 'Any'|trans({}, domain) }}</option>
					{% for id, title in payment_modules %}<option value="{{ id }}"{% if id == simulation_input.payment %} selected{% endif %}>{{ title }}</option>{% endfor %}
				</select>
			</div>
			<div class="col-md-3">
				<label class="form-label" for="stockmanager-simulate-target">{{ 'To'|trans({}, domain) }}</label>
				<select class="form-select" id="stockmanager-simulate-target" name="simulate_target" required>
					{% for id, title in statuses %}<option value="{{ id }}"{% if id == simulation_input.target %} selected{% endif %}>{{ title }}</option>{% endfor %}
				</select>
			</div>
			<div class="col-12">
				<button type="submit" class="btn btn-outline-primary">{{ 'Simulate'|trans({}, domain) }}</button>
			</div>
		</form>

		{% if simulation %}
			<div class="mt-3" data-testid="stockmanager-simulation-result">
				{% if simulation.error is defined %}
					<div class="alert alert-danger">{{ simulation.error|trans({}, domain) }}</div>
				{% else %}
					<p class="mb-1">
						{% if simulation.order_reference %}{{ 'Order %ref%'|trans({'%ref%': simulation.order_reference}, domain) }} : {% endif %}
						{{ simulation.source }} → {{ simulation.target }}{% if simulation.payment_module %} ({{ simulation.payment_module }}){% endif %}
					</p>
					{% if simulation.same_status %}
						<div class="alert alert-info">{{ 'The order is already in this status: nothing happens.'|trans({}, domain) }}</div>
					{% else %}
						{% if not simulation.transition_allowed %}
							<div class="alert alert-warning">{{ 'This change of status is not allowed by the transitions of the shop.'|trans({}, domain) }}</div>
						{% endif %}
						{% if simulation.rule %}
							<div class="alert alert-success" data-testid="stockmanager-simulation-rule">{{ 'Rule #%position% decides: %operation%.'|trans({'%position%': simulation.rule.rank, '%operation%': simulation.rule.operation|trans({}, domain)}, domain) }}</div>
						{% elseif simulation.order_reference %}
							<div class="alert alert-secondary" data-testid="stockmanager-simulation-core">{{ 'No rule matches: Thelia decides.'|trans({}, domain) }}</div>
						{% else %}
							<div class="alert alert-secondary" data-testid="stockmanager-simulation-core">{{ 'No rule matches: Thelia decides, according to whether the order is paid and to its payment module.'|trans({}, domain) }}</div>
						{% endif %}
						{% if simulation.order_reference %}
							<p class="mb-0" data-testid="stockmanager-simulation-operation"><strong>{{ simulation.operation|trans({}, domain) }}</strong>{% if simulation.rule %} {{ '(without the rule: %operation%)'|trans({'%operation%': simulation.core_operation|trans({}, domain)}, domain) }}{% endif %}</p>
						{% endif %}
					{% endif %}
				{% endif %}
			</div>
		{% endif %}
	</div>
</div>
