<?xml version="1.0" encoding="UTF-8"?>
<database defaultIdMethod="native" name="TheliaMain"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="../../../../vendor/thelia/propel/resources/xsd/database.xsd" >

    <!-- A status or a payment module deleted leaves its rule in place, without it: the
         back office flags the rule and it never matches again, rather than vanishing. -->
    <table name="stock_manager_rule" namespace="StockManager\Model">
        <column autoIncrement="true" name="id" primaryKey="true" required="true" type="INTEGER" />
        <column name="position" required="true" type="INTEGER" />
        <column name="source_status_id" type="INTEGER" />
        <column name="target_status_id" type="INTEGER" />
        <column name="operation" required="true" size="16" type="VARCHAR" />
        <column name="payment_restricted" required="true" defaultValue="0" type="BOOLEAN" />
        <column name="payment_module_id" type="INTEGER" />
        <foreign-key foreignTable="order_status" name="fk_stock_manager_rule_source_status" onDelete="SET NULL" onUpdate="RESTRICT">
            <reference foreign="id" local="source_status_id" />
        </foreign-key>
        <foreign-key foreignTable="order_status" name="fk_stock_manager_rule_target_status" onDelete="SET NULL" onUpdate="RESTRICT">
            <reference foreign="id" local="target_status_id" />
        </foreign-key>
        <foreign-key foreignTable="module" name="fk_stock_manager_rule_payment_module" onDelete="SET NULL" onUpdate="RESTRICT">
            <reference foreign="id" local="payment_module_id" />
        </foreign-key>
        <index name="idx_stock_manager_rule_transition">
            <index-column name="source_status_id" />
            <index-column name="target_status_id" />
        </index>
        <behavior name="timestampable" />
    </table>

    <external-schema filename="local/config/schema.xml" referenceOnly="true" />
</database>
